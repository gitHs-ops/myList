# Anthropic API 키 (필수)
ANTHROPIC_API_KEY=sk-ant-...

# 사용할 비전 모델 (선택, 기본 claude-opus-5)
# 비용 절감 시: claude-sonnet-5
VISION_MODEL=claude-opus-5

# 포트 (선택, 기본 8787)
PORT=8787

# 임의의 긴 무작위 문자열 (필수). index.html의 "백엔드 설정 > 접근 코드"에 동일한 값을 입력해야
# API 호출이 통과합니다. 이 값이 없으면 URL을 아는 누구나 이 서버로 비전 API 요금을 발생시킬 수 있습니다.
APP_SHARED_SECRET=

# 테스터에게 접근 코드 없이 정해진 기간만 열어줘야 할 때만 설정 (ISO 시각, UTC 기준).
# [FROM, UNTIL) 구간에서만 접근 코드 없이 누구나 호출 가능 — 구간 지나면 자동으로 다시 잠김.
# FROM 생략 시 즉시 시작. 평소엔 둘 다 비워둘 것.
# 예: 한국시간 2026-09-21 00:00 ~ 2026-10-06 00:00(=10/5 자정까지)
TEMP_AUTH_BYPASS_FROM=
TEMP_AUTH_BYPASS_UNTIL=
